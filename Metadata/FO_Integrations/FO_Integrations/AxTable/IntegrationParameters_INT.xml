		<Methods>
			<Method>
				<Name>find</Name>
				<Source><![CDATA[
    public static IntegrationParameters_INT find(boolean update = false)
    {
        IntegrationParameters_INT parameter;

        parameter.selectForUpdate(update);

        select firstonly parameter
            index KeyIdx
            where parameter.Key == 0;

        if (!parameter && !parameter.isTmp())
        {
            Company::createParameter(parameter);
        }

        return parameter;
    }

]]></Source>
