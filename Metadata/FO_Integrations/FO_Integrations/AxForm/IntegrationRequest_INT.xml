						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        public void init()
        {
            super();

            if(enumType == enumNum(IntegrationFilter_INT))
            {
                
                switch (enum)
                {
                    case (IntegrationFilter_INT::Error):
                        break;
                    case (IntegrationFilter_INT::ClaimCheck):
                        this.queryBuildDataSource().addRange(fieldNum(IntegrationSetup_INT,InstanceRelationType)).value(SysQuery::value(TableNum(IntegrationSetupClaimCheck_INT)));
                        break;
                    default:
                        this.queryBuildDataSource().addRange(fieldNum(IntegrationSetup_INT,InstanceRelationType)).value(SysQuery::valueNot(TableNum(IntegrationSetupClaimCheck_INT)));
                        break;
                }
            }

        }

