					<Method>
						<Name>init</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        public void init()
        {
            super();

            QueryBuildDataSource qbds = this.queryBuildDataSource();

            qbds.addSortField(fieldNum(IntegrationRequest_INT,DateTimeStamp),SortOrder::Descending);
 

            if(callerRecord)
            {
                if(callerRecord is IntegrationSetup_INT)
                {
                    IntegrationSetup_INT setup = callerRecord as IntegrationSetup_INT;
                
                    qbds.addRange(fieldNum(IntegrationRequest_INT,IntegrationName)).value(setup.IntegrationName);
                }
            }
            if(enumType == enumNum(IntegrationFilter_INT))
            {
                
                switch (enum)
                {
                    case (IntegrationFilter_INT::Error):
                        qbds.addRange(fieldNum(IntegrationRequest_INT,State)).value(queryValue(IntegrationState_INT::Failed));
                        break;
                    case (IntegrationFilter_INT::Ingoing):
                        qbds.addRange(fieldNum(IntegrationRequest_INT,Direction)).value(queryValue(IntegrationDirection_INT::In));
                        break;
                    case (IntegrationFilter_INT::Outgoing):
                        qbds.addRange(fieldNum(IntegrationRequest_INT,Direction)).value(queryValue(IntegrationDirection_INT::Out));
                        break;
            
                }

            }

        }

]]></Source>
